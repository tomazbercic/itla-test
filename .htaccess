# www.itla.si (iz itla-site/build/static/prod, ne urejaj na strezniku)
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On
# itla.si in http -> https://www.itla.si (razen preverjanja SSL)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.itla\.si$ [NC]
RewriteRule ^ https://www.itla.si%{REQUEST_URI} [L,R=301]
</IfModule>

# Stare Muse strani, ki jih ni vec
Redirect 301 /publications.html /index.html

<IfModule mod_headers.c>
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.(jpe?g|png|webp|svg|gif|ico|woff2?)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.(pdf|docx)$">
Header set Cache-Control "public, max-age=86400"
</FilesMatch>
</IfModule>
